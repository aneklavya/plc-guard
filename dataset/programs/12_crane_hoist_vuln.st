PROGRAM CraneHoist
  VAR
    PB_UP    AT %IX0.0 : BOOL;
    PB_DN    AT %IX0.1 : BOOL;
    LS_TOP   AT %IX0.2 : BOOL;
    LS_BOT   AT %IX0.3 : BOOL;
    OL_M201  AT %IX0.4 : BOOL;
    M201_UP  AT %QX0.0 : BOOL;
    M201_DN  AT %QX0.1 : BOOL;
  END_VAR

  M201_UP := PB_UP AND NOT PB_DN;
  M201_DN := PB_DN AND NOT PB_UP AND NOT LS_BOT AND NOT OL_M201;
END_PROGRAM
